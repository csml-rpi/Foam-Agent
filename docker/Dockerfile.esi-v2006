# Native ESI/OpenCFD v2006 Foam-Agent image.
# Build from the project root:
# docker build -f docker/Dockerfile.esi-v2006 -t foamagent:esi-v2006 .

FROM ubuntu:20.04 AS openfoam-builder

ARG OPENFOAM_VERSION=v2006
ARG OPENFOAM_MD5=1226d48e74a4c78f12396cb586c331d8
ARG THIRD_PARTY_MD5=6b598b6faa6ddeb25235c5dded0ca275
ARG OPENFOAM_BUILD_JOBS=4

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN for attempt in 1 2 3; do \
        apt-get -o Acquire::Retries=5 update && \
        DEBIAN_FRONTEND=noninteractive apt-get -o Acquire::Retries=5 install -y \
            build-essential bison flex cmake curl file gawk git libboost-system-dev \
            libopenmpi-dev openmpi-bin mpi-default-bin perl python3 python3-dev \
            tcsh zlib1g-dev && break; \
        if [ "$attempt" = 3 ]; then exit 1; fi; \
        sleep 5; \
    done && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/OpenFOAM
RUN download() { \
        url="$1"; file="$2"; \
        for attempt in 1 2 3 4 5; do \
            curl --fail --location --connect-timeout 30 --speed-limit 1024 --speed-time 60 \
                --continue-at - --output "$file" "$url" && return 0; \
            if [ "$attempt" = 5 ]; then return 1; fi; \
            sleep 5; \
        done; \
    }; \
    download 'https://sourceforge.net/projects/openfoam/files/v2006/OpenFOAM-v2006.tgz/download?use_mirror=netix' OpenFOAM-v2006.tgz && \
    echo "${OPENFOAM_MD5}  OpenFOAM-v2006.tgz" | md5sum --check - && \
    download 'https://sourceforge.net/projects/openfoam/files/v2006/ThirdParty-v2006.tgz/download?use_mirror=netix' ThirdParty-v2006.tgz && \
    echo "${THIRD_PARTY_MD5}  ThirdParty-v2006.tgz" | md5sum --check - && \
    tar -xzf OpenFOAM-v2006.tgz && tar -xzf ThirdParty-v2006.tgz && \
    rm OpenFOAM-v2006.tgz ThirdParty-v2006.tgz
RUN source /opt/OpenFOAM/OpenFOAM-v2006/etc/bashrc && \
    /opt/OpenFOAM/OpenFOAM-v2006/Allwmake -j"${OPENFOAM_BUILD_JOBS}"

# Build from the repository root with hydrated target corpus files.
FROM ubuntu:20.04 AS builder
COPY --from=openfoam-builder /opt/OpenFOAM /opt/OpenFOAM
USER root
RUN apt-get update && apt-get install -y --no-install-recommends wget ca-certificates python3 && rm -rf /var/lib/apt/lists/*
ENV CONDA_DIR=/opt/conda
ENV FoamAgent_PATH=/home/openfoam/Foam-Agent
WORKDIR /home/openfoam/Foam-Agent
COPY scripts/verify_target_corpus.py /tmp/verify_target_corpus.py
COPY database/esi-v2006/ database/esi-v2006/
RUN python3 /tmp/verify_target_corpus.py --target esi-v2006 --database-path /home/openfoam/Foam-Agent/database/esi-v2006
COPY environment.yml pyproject.toml constraints.txt ./
COPY docker/install-python.sh /tmp/install-python.sh
RUN bash /tmp/install-python.sh
# Prepare client tokenizers too, so the first LLM request needs no asset download.
ENV TIKTOKEN_CACHE_DIR=/opt/foamagent-tokenizers
RUN /opt/conda/envs/FoamAgent/bin/python -c "import tiktoken; tiktoken.get_encoding('cl100k_base'); tiktoken.get_encoding('o200k_base'); from langchain_core.language_models.base import get_tokenizer; get_tokenizer()"

# Pin model assets independently of the location used to load them.
ARG EMBEDDING_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
RUN /opt/conda/envs/FoamAgent/bin/python -c "from huggingface_hub import snapshot_download; snapshot_download('Qwen/Qwen3-Embedding-0.6B', revision='$EMBEDDING_REVISION', local_dir='/opt/foamagent-model', allow_patterns=['*.json', '*.safetensors', '*.txt', 'README.md'])" && \
    rm -rf /opt/foamagent-model/.cache

COPY src/ src/
COPY scripts/ scripts/
COPY examples/ examples/
COPY foambench_main.py user_requirement.txt LICENSE README.md ./
RUN /opt/conda/envs/FoamAgent/bin/python -m pip install --no-cache-dir --no-deps -e .

FROM ubuntu:20.04
COPY --from=openfoam-builder /opt/OpenFOAM /opt/OpenFOAM
USER root
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates xvfb libgl1 libglu1-mesa libgomp1 libopenmpi-dev openmpi-bin libboost-system1.71.0 libxrender1 libxext6 libsm6 && rm -rf /var/lib/apt/lists/*
ENV CONDA_DIR=/opt/conda \
    FoamAgent_PATH=/home/openfoam/Foam-Agent \
    TIKTOKEN_CACHE_DIR=/opt/foamagent-tokenizers \
    PATH=/opt/conda/envs/FoamAgent/bin:/opt/conda/bin:$PATH \
    FOAMAGENT_IMAGE_OPENFOAM_TARGET=esi-v2006 \
    FOAMAGENT_OPENFOAM_TARGET=esi-v2006 \
    FOAMAGENT_BUNDLED_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B \
    FOAMAGENT_BUNDLED_EMBEDDING_MODEL_PATH=/opt/foamagent-model
COPY --from=builder /opt/conda /opt/conda
COPY --from=builder /opt/foamagent-model /opt/foamagent-model
COPY --from=builder /opt/foamagent-tokenizers /opt/foamagent-tokenizers
COPY --from=builder /root/.cache/huggingface/hub /root/.cache/huggingface/hub
COPY --from=builder /home/openfoam/Foam-Agent /home/openfoam/Foam-Agent
COPY docker/foamagent-entrypoint.sh /usr/local/bin/foamagent-entrypoint.sh
ARG VCS_REF=local
ARG VERSION=local
ENV FOAMAGENT_IMAGE_REVISION=$VCS_REF
LABEL org.opencontainers.image.source="https://github.com/csml-rpi/Foam-Agent" \
      org.opencontainers.image.revision=$VCS_REF \
      org.opencontainers.image.version=$VERSION
RUN chmod +x /usr/local/bin/foamagent-entrypoint.sh && \
    printf '\nsource /opt/conda/etc/profile.d/conda.sh\nconda activate FoamAgent\nsource /opt/OpenFOAM/OpenFOAM-v2006/etc/bashrc\ncd /home/openfoam/Foam-Agent\n' >> /root/.bashrc
WORKDIR /home/openfoam/Foam-Agent
ENTRYPOINT ["/usr/local/bin/foamagent-entrypoint.sh"]
CMD ["/bin/bash"]
