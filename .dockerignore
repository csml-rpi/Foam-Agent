# Exclude runs directory (can be very large)
runs/

# Exclude generated outputs (often large)
output/
logs/
.venv/

# Local configuration and credentials
.env
.env.*
!.env.example
CLAUDE.md
PR_DESCRIPTION.md
usage_nrel_aws.json
.claude/settings.local.json
.claude/memory/

# Exclude Python cache files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.coverage*
htmlcov/

# Exclude git files
.git/
.gitignore
.gitattributes

# Exclude IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Exclude test outputs and temporary files
*.log
*.tmp
*.bak

# Target corpora under database/ are required in the build context.
