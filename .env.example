# Copy to .env; select the provider and model together.
FOAMAGENT_MODEL_PROVIDER=openai
FOAMAGENT_MODEL_VERSION=gpt-5-mini
OPENAI_API_KEY=replace-with-your-key

# For an OpenAI-compatible endpoint without native structured output:
# OPENAI_BASE_URL=https://your-endpoint/v1
# FOAMAGENT_STRUCTURED_OUTPUT_METHOD=json_prompt

# Tutorial embedding model identity; must match the prebuilt FAISS indices.
FOAMAGENT_EMBEDDING_PROVIDER=huggingface
FOAMAGENT_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# Optional local copy of that same model (use the container path with Docker).
# FOAMAGENT_EMBEDDING_MODEL_PATH=/models/Qwen3-Embedding-0.6B
# HF_HUB_OFFLINE=1
